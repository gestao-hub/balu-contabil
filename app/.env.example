# .env.example — Balu (template; copie para .env.local e preencha)
# .env.local NÃO deve ser commitado (já está no .gitignore).
# Os comentários dizem onde pegar cada chave.
#
# ── OBRIGATÓRIAS: sem estas o app não sobe ou perde dado ─────────────────────

# Base canônica do app (usada pra gerar links de email — confirmação signup,
# reset de senha). NÃO derivar de Host/Origin headers (Host Header Injection).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase principal (auth + cadastros: clientes, empresa, dashboard, notas)
# Dashboard Supabase → Project Settings → API
#   - URL          → "Project URL"
#   - ANON_KEY     → "Project API keys › anon public"
#   - SERVICE_ROLE → "Project API keys › service_role"  (SECRETA — só server-side)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Focus NFe: o token DA PLATAFORMA ──────────────────────────────────────────
#
# ⚠️ A FOCUS TEM DOIS NÍVEIS DE TOKEN, E TROCÁ-LOS CUSTOU 40 DIAS DE CADASTRO
# QUEBRADO (23/07 a 01/09/2026):
#
#   token PRINCIPAL DA CONTA   Serviços > Painel API > Tokens no painel da Focus.
#                              É o ÚNICO aceito em /v2/empresas — o endpoint que
#                              cadastra empresa. É o que vai aqui.
#   token DE UMA EMPRESA       vem no POST /v2/empresas, um par por CNPJ. Serve
#                              só para EMITIR nota daquela empresa, e o Balu o
#                              guarda cifrado em `empresa_credenciais_focus`.
#                              NUNCA vai numa variável de ambiente.
#
# Os dois autenticam igual em /v2/codigos_cnae, então um token de empresa colado
# aqui parece funcionar e falha só no cadastro, com 401 "permissao_negada". Era
# exatamente esse o estado do `.env.local` até 01/09/2026.
#
# A FONTE DE VERDADE É O BANCO: cole o token em /admin/configuracoes/focus e
# clique em "Testar" — a sonda bate no catálogo E em /v2/empresas, que é o que
# distingue os dois níveis. O banco vence estas variáveis (ver `config-focus.ts`),
# que ficam como rede de segurança de deploy.
FOCUS_NFE_TOKEN_PRODUCAO=
# Genérico, ÚLTIMO recurso: usado para QUALQUER ambiente quando o específico não
# existe — inclusive produção. Não coloque um token de homologação aqui.
FOCUS_NFE_TOKEN=
#
# Não existe `FOCUS_NFE_HOMOLOGACAO`: nenhum caminho do produto lê o token de
# homologação DA PLATAFORMA. Toda chamada de homologação (emitir, consultar,
# baixar, cancelar) carrega o token da EMPRESA.
#
# Também não existe `FOCUS_NFE_ENV`: o ambiente sai de
# `empresas_fiscais.focus_ambiente`, por empresa, resolvido em
# `resolver-credencial.ts`. A variável esteve documentada aqui por meses sem
# nenhum código a ler.

# Cifra os certificados A1 E os tokens de API guardados no banco (base64, 32
# bytes). Gere a sua:  openssl rand -base64 32
#
# ⚠️ NÃO é opcional, e NÃO troque depois de usar: o que já foi cifrado com a
# chave antiga vira lixo indecifrável — certificado de cliente inclusive.
CERT_ENC_KEY=

# Proteção das rotas de cron (Vercel injeta automaticamente em produção)
CRON_SECRET=

# ── INTEGRAÇÕES: a ausência desliga a funcionalidade, não derruba o app ───────

# Serpro Integra Contador (DAS, PGDAS-D, DASN-SIMEI).
# Portal Serpro Integra Contador → suas credenciais de consumidor.
SERPRO_CONSUMER_KEY=
SERPRO_CONSUMER_SECRET=

# WhatsApp (UAZAPI) — atendimento automatizado.
# ⚠️ Produção exige um chip DEDICADO: numa instância em número pessoal, conversa
# de terceiro atravessa o webhook e vira linha no banco do cliente.
UAZAPI_BASE_URL=
# ⚠️ É `UAZAPI_TOKEN` — token DA INSTÂNCIA — que o app lê para enviar mensagem
# (lib/uazapi/cliente.ts). Não confunda com UAZAPI_ADMIN_TOKEN abaixo: com o
# nome errado, `configDeEnv()` devolve null, `enviarMensagem` retorna
# `{ ok: false, skipped: true }` e o WhatsApp simplesmente NUNCA envia — sem
# erro em lugar nenhum.
UAZAPI_TOKEN=
UAZAPI_WEBHOOK_SECRET=

# e-mails de convite/aprovação (Bloco A)
RESEND_API_KEY=
EMAIL_FROM="Balu <noreply@exemplo.com>"

# Segredo do webhook da Focus (query param ?s= na URL de callback configurada na Focus) — Bloco E
FOCUS_WEBHOOK_SECRET=

# ── Asaas (Bloco 4A — cobrança da assinatura da Balu) ─────────────────────────
# Ambiente: "prod" só quando explicitamente pedido. Qualquer outro valor —
# inclusive ausente — é sandbox. O default nunca pode ser o que cobra.
ASAAS_ENV=sandbox
# Tokens SEPARADOS por ambiente, e não uma chave única: token de sandbox na
# URL de produção dá 401, e uma chave só convida a apontar a de produção para
# o sandbox sem perceber. Mesma separação que a Focus faz.
#   sandbox.asaas.com → Configurações → Integrações → Gerar chave de API.
# Sem o token o app sobe e funciona normalmente; só as telas de assinatura e
# o webhook ficam inertes.
#
# ⚠️ EM ARQUIVO .env, ESCAPE O "$" INICIAL: o token do Asaas começa com
# `$aact_…`, e o Next passa o .env pelo dotenv-expand, que lê `$aact_…` como
# referência de variável e resolve para string VAZIA. O app então diz
# "não configurado" com a chave certa no arquivo. Escreva `\$aact_…`.
# (Não vale para a Vercel: lá o valor não passa por dotenv — cole cru.)
TOKEN_ASAAS_SANDBOX=
TOKEN_ASAAS_PRODUCAO=
# Segredo do webhook do Asaas. Diferente da Focus, vai no HEADER
# `asaas-access-token` — configure o mesmo valor no painel do Asaas em
# Configurações → Integrações → Webhooks → "Token de autenticação".
#
# ⚠️ MÍNIMO DE 32 CARACTERES. Observado contra o sandbox: o cadastro por API
# responde 400 "O token deve ter pelo menos 32 caracteres". Abaixo disso o
# webhook da CONTA-MÃE (feito à mão no painel) até funciona, mas o das
# SUBCONTAS — que o app cadastra sozinho, ver lib/billing/webhook-subconta.ts —
# nunca é criado, e nenhum escritório fica sabendo que foi pago.
#
# ⚠️ É O MESMO SEGREDO PARA TODAS AS SUBCONTAS, por construção: quem confere é
# `segredoDoHeader` na rota, que compara com este único valor. Trocá-lo exige
# reconfigurar o webhook de todo escritório (botão "Reconfigurar avisos").
ASAAS_WEBHOOK_SECRET=
# Para onde o Asaas avisa que PAROU de entregar os eventos de uma subconta.
# Campo obrigatório no cadastro do webhook (observado no sandbox). O dono certo
# do aviso é a Balu, não o escritório: o endereço, o segredo e o conserto são
# todos nossos. Sem esta variável cai em EMAIL_FROM; sem as duas, o webhook das
# subcontas não é cadastrado (e a tela da subconta diz isso).
ASAAS_WEBHOOK_EMAIL=

# ── FERRAMENTAS (não lidas pelo app em runtime) ───────────────────────────────
# Senha do Postgres, usada só pelo runner de migrations:
#   node scratchpad/apply-migration.mjs supabase/migrations/XXXX.sql
# Supabase → Project Settings → Database → Database password.
SUPABASE_PASSWORD=

# Token ADMINISTRATIVO da UAZAPI — provisiona/troca a instância pelos scripts de
# scratchpad (_criar-instancia-balu.mjs). O app NÃO lê esta variável.
UAZAPI_ADMIN_TOKEN=

# ── NÃO existe como variável de ambiente ──────────────────────────────────────
# A chave do OpenRouter (modelo que redige a resposta do WhatsApp) NÃO é lida do
# ambiente: fica cifrada no banco, em `config_ia`, e se configura pela tela
# /admin/configuracoes/ia. Procurá-la aqui manda o operador ao lugar errado
# enquanto a IA segue sem configurar.
#
# A IA só EXPLICA número que o código determinístico já calculou; nada com
# efeito fiscal sai dela.
