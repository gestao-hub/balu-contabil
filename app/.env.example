# .env.example — Balu (template; copie para .env.local e preencha)
# .env.local NÃO deve ser commitado (já está no .gitignore).
# Os comentários dizem onde pegar cada chave.
#
# ── NECESSÁRIO PARA A "REVISÃO BALU" (runtime atual) ──────────────────────────

# Base canônica do app (usada pra gerar links de email — confirmação signup,
# reset de senha). NÃO derivar de Host/Origin headers (Host Header Injection).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase principal (auth + cadastros: clientes, empresa, dashboard, notas)
# Dashboard Supabase → Project Settings → API
#   - URL          → "Project URL"
#   - ANON_KEY     → "Project API keys › anon public"
#   - SERVICE_ROLE → "Project API keys › service_role"  (SECRETA — só server-side)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Focus NFe — token de SANDBOX (homologação). Necessário p/ lookup de CNPJ no onboarding.
# Painel Focus NFe → Tokens → ambiente de homologação.
FOCUS_NFE_TOKEN=
# Ambiente do Focus: "hom" (sandbox) ou "prod". Default = hom se vazio/!= prod.
FOCUS_NFE_ENV=hom

# ── PARA PRs FUTUROS (Day 2/3 — não exigido pela revisão de agora) ────────────

# Serpro Integra Contador (geração de DAS — PR 3.2). Trial serve.
# Portal Serpro Integra Contador → suas credenciais de consumidor.
SERPRO_CONSUMER_KEY=
SERPRO_CONSUMER_SECRET=

# n8n motor fiscal (consolidar receitas / RBT12 — PR 3.x).
# Base URL fixa em código: https://webhooks.envia.click
# Segredo HMAC combinado com o n8n.
N8N_WEBHOOK_SECRET=
N8N_WEBHOOK_key=

# ── Declaradas mas o código atual NÃO lê (deixe em branco) ────────────────────
# Supabase "motor fiscal" — reservado p/ acesso direto às tabelas de apuração.
SUPABASE_MOTOR_URL=
SUPABASE_MOTOR_ANON_KEY=
# Chave de criptografia dos certificados A1 (base64, 32 bytes). Gere a sua:
#   openssl rand -base64 32
CERT_ENC_KEY=

# Proteção das rotas de cron (Vercel injeta automaticamente em produção)
CRON_SECRET=

# e-mails de convite/aprovação (Bloco A)
RESEND_API_KEY=
EMAIL_FROM="Balu <noreply@exemplo.com>"

# Segredo do webhook da Focus (query param ?s= na URL de callback configurada na Focus) — Bloco E
FOCUS_WEBHOOK_SECRET=

# ── Asaas (Bloco 4A — cobrança da assinatura da Balu) ─────────────────────────
# Ambiente: "prod" só quando explicitamente pedido. Qualquer outro valor —
# inclusive ausente — é sandbox. O default nunca pode ser o que cobra.
ASAAS_ENV=sandbox
# Tokens SEPARADOS por ambiente, e não uma chave única: token de sandbox na
# URL de produção dá 401, e uma chave só convida a apontar a de produção para
# o sandbox sem perceber. Mesma separação que a Focus faz.
#   sandbox.asaas.com → Configurações → Integrações → Gerar chave de API.
# Sem o token o app sobe e funciona normalmente; só as telas de assinatura e
# o webhook ficam inertes.
#
# ⚠️ EM ARQUIVO .env, ESCAPE O "$" INICIAL: o token do Asaas começa com
# `$aact_…`, e o Next passa o .env pelo dotenv-expand, que lê `$aact_…` como
# referência de variável e resolve para string VAZIA. O app então diz
# "não configurado" com a chave certa no arquivo. Escreva `\$aact_…`.
# (Não vale para a Vercel: lá o valor não passa por dotenv — cole cru.)
TOKEN_ASAAS_SANDBOX=
TOKEN_ASAAS_PRODUCAO=
# Segredo do webhook do Asaas. Diferente da Focus, vai no HEADER
# `asaas-access-token` — configure o mesmo valor no painel do Asaas em
# Configurações → Integrações → Webhooks → "Token de autenticação".
#
# ⚠️ MÍNIMO DE 32 CARACTERES. Observado contra o sandbox: o cadastro por API
# responde 400 "O token deve ter pelo menos 32 caracteres". Abaixo disso o
# webhook da CONTA-MÃE (feito à mão no painel) até funciona, mas o das
# SUBCONTAS — que o app cadastra sozinho, ver lib/billing/webhook-subconta.ts —
# nunca é criado, e nenhum escritório fica sabendo que foi pago.
#
# ⚠️ É O MESMO SEGREDO PARA TODAS AS SUBCONTAS, por construção: quem confere é
# `segredoDoHeader` na rota, que compara com este único valor. Trocá-lo exige
# reconfigurar o webhook de todo escritório (botão "Reconfigurar avisos").
ASAAS_WEBHOOK_SECRET=
# Para onde o Asaas avisa que PAROU de entregar os eventos de uma subconta.
# Campo obrigatório no cadastro do webhook (observado no sandbox). O dono certo
# do aviso é a Balu, não o escritório: o endereço, o segredo e o conserto são
# todos nossos. Sem esta variável cai em EMAIL_FROM; sem as duas, o webhook das
# subcontas não é cadastrado (e a tela da subconta diz isso).
ASAAS_WEBHOOK_EMAIL=
