# ── Dependências ─────────────────────────────────────────────
node_modules

# ── Next.js / build ──────────────────────────────────────────
.next
out
next-env.d.ts
*.tsbuildinfo

# ── PWA (Serwist gera estes no build) ────────────────────────
public/sw.js
public/sw.js.map
public/swe-worker-*.js

# ── Segredos / ambiente ──────────────────────────────────────
.env
.env.local
.env*.local
# Copias de seguranca do .env (ex.: .env.local.bak-asaas). Sem esta linha um
# backup de segredos fica visivel no `git status` esperando um `git add -A`.
.env.local.*
.env.example

# ── Scratchpad (aplicadores de migration, seeds e probes) ────
# Sempre foi tratado como nao versionado, mas nunca esteve ignorado: aparecia
# como `??` no status, a um `git add -A` distraido de virar commit. Os scripts
# daqui leem SUPABASE_PASSWORD e CERT_ENC_KEY do .env.local.
scratchpad/

# ── Testes (Vitest / Playwright) ─────────────────────────────
playwright-report
blob-report
test-results
.playwright
.playwright-mcp
screenshots

# ── Vercel ───────────────────────────────────────────────────
.vercel

# ── Supabase CLI (cache local de `supabase link`, sem segredo) ─
supabase/.temp

# ── Kanban stray (o canônico é o .kanban/ da raiz) ───────────
.kanban

# ── Logs ─────────────────────────────────────────────────────
*.log
